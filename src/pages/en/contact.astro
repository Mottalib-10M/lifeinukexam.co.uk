---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { displayDate } from '../../lib/format';
const lang = 'en';
---
<PageLayout title={`Contact ${SITE_NAMES[lang]}: a fee, a question, the widget`} description="Write to Life in UK Exam when a fee or residence rule looks out of date, when a practice question seems wrong, or to embed the free mock test on a library or college site." lang={lang} noindex={true} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Contact</h1>
    <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. A person reads every message.</p>
    <h2>A fee or a rule looks out of date</h2>
    <p>Tell us the rule and, if you have it, the gov.uk page that says otherwise. Home Office fees change on set dates through the fees table, and some pages are updated later than others. We read the official source again, correct the parameter file and date the change.</p>
    <h2>A practice question seems wrong</h2>
    <p>Give us the first words of the question. Each one names the handbook chapter it was written from; if the handbook and current reality differ, we rewrite or remove the question.</p>
    <h2>What we cannot do</h2>
    <p>We are not a government service or an adviser. We cannot book a test, check an application or advise on a personal case. Please do not send passport numbers, application numbers or dates of birth.</p>
    <h2>Using a test on your own site</h2>
    <p>Libraries, colleges and community groups that help new residents can show the mock test or the date calculator in an iframe at no cost: see the <a href={route('widget', lang)}>embed page</a>.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
    <p>Updated on <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, 'en-GB')}</time>.</p>
  </div>
</PageLayout>
